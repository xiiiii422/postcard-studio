# Postcard Studio · configuration example
#
# Copy this file to `.env` in the same folder and fill in your own values.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
# The app reads `.env` at startup; process environment variables take precedence.
# `.env` may contain secrets - it is excluded by .gitignore, never commit it.

# ---- AI (optional) ---------------------------------------------------------
# SiliconFlow key (free tier available): https://cloud.siliconflow.cn/account/ak
# Used for: photo element recognition (Qwen3-VL), photo restyle (img2img),
# and text-to-image backgrounds. Leave commented out to use GLM-4V for
# recognition (if GLM_API_KEY is set) or to run fully offline with the vector
# renderer - the UI will say AI is unavailable.
#SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GLM (Zhipu) key: https://open.bigmodel.cn/
# Used only for photo recognition via glm-4v-flash when SILICONFLOW_API_KEY is
# absent. Image generation still requires SiliconFlow.
#GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# Optional fallback vision model (the public DeepSeek models are text-only today,
# so this is only useful if your account exposes a vision-capable model).
DEEPSEEK_API_KEY=

# ---- server ----------------------------------------------------------------
# Loopback only by default. Use 0.0.0.0 only if you knowingly want every device
# on your LAN to be able to upload and render; there is no authentication.
POSTCARD_HOST=127.0.0.1
POSTCARD_PORT=5179
# Render threads. One 600dpi render saturates a core; 12 is plenty.
POSTCARD_THREADS=12

# ---- optional Cloudflare tunnel (off by default) ---------------------------
# `启动明信片.bat --tunnel` or setting POSTCARD_TUNNEL=1 starts cloudflared.
# For a named tunnel set POSTCARD_TUNNEL_NAME; without it a quick tunnel is
# started and its random URL is printed in ntunnel.err.log.
#POSTCARD_TUNNEL=0
#POSTCARD_TUNNEL_NAME=my-postcard-tunnel

# ---- interpreter / credentials (usually not needed) ------------------------
# find-python.ps1 runs before .env is read, so this must be a real environment
# variable if you want to force an interpreter:
#   powershell  $env:POSTCARD_PY="C:\path\to\python.exe"

# Optional: read AI keys from a DeepSeek Harness credentials file.
#DSH_HOME=~/deepseek-harness
#DSH_CRED=~/deepseek-harness/dsh-home/.credentials.yaml
